# Copy to .env on the server (/opt/stack/.env) and fill in real values.
# NEVER commit the real .env. All values below are dummies.

# Public domain served by Caddy (apex + subdomains).
DOMAIN=tengudance.com
# Email used by Caddy for ACME / Let's Encrypt notices.
ADMIN_EMAIL=catrini.m@gmail.com

# PostgreSQL superuser. Apps should get their own roles/databases.
POSTGRES_USER=postgres
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-dummy-password

# Image tag of the placeholder app (pinned; never "latest").
# To roll back an app, set its tag here and run scripts/deploy.sh <service>.
PLACEHOLDER_APP_IMAGE=mcr.microsoft.com/dotnet/samples:aspnetapp

# Optional S3-compatible offsite backups. Leave S3_BUCKET empty to disable.
S3_ENDPOINT=https://s3.example.com
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY=dummy-access-key
S3_SECRET_KEY=dummy-secret-key
# Prefix ("folder") inside the bucket.
S3_PREFIX=friends-arcade-backups
